{
  "name": "heimdall-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "bun test packages",
    "verify": "bun run check && bun run test",
    "build:collector": "bun run --cwd packages/collector loom build --out ../../dist/heimdall-collector",
    "build:dashboard": "bun run --cwd packages/dashboard build && bun run --cwd packages/dashboard loom build --out ../../dist/heimdall-dashboard",
    "build:hub": "bun run --cwd packages/hub loom build --out ../../dist/heimdall-hub",
    "release": "bun packages/release/src/main.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "vite-plus": "^1.1.0"
  }
}

{
  "name": "heimdall-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "bun test packages",
    "verify": "bun run check && bun run test",
    "build:collector": "bun build packages/collector/src/main.ts --compile --define '__LOOM_RELEASE__={\"build\":\"distributed\"}' --outfile dist/heimdall-collector",
    "build:hub": "bun build packages/hub/src/main.ts --compile --define '__LOOM_RELEASE__={\"build\":\"distributed\"}' --outfile dist/heimdall-hub",
    "release": "bun packages/release/src/main.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "vite-plus": "^1.0.0"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "databases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "system": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          }
        },
        "required": [
          "name",
          "role",
          "system"
        ],
        "additionalProperties": false
      }
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "systems": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "applications": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "channel": {
                  "type": "string",
                  "enum": [
                    "stable",
                    "next"
                  ]
                },
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                },
                "release": {
                  "type": "string",
                  "pattern": "^v?[0-9A-Za-z][0-9A-Za-z._-]*$"
                },
                "repository": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
                }
              },
              "required": [
                "channel",
                "name",
                "release",
                "repository"
              ],
              "additionalProperties": false
            }
          },
          "backupJobs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                },
                "retentionDays": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3650
                },
                "schedule": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "hour": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 23
                      },
                      "minute": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 59
                      }
                    },
                    "required": [
                      "hour",
                      "minute"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "name",
                "retentionDays",
                "schedule"
              ],
              "additionalProperties": false
            }
          },
          "harnesses": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
            }
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "os": {
            "type": "string",
            "enum": [
              "darwin",
              "linux"
            ]
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                },
                "supervisor": {
                  "type": "string",
                  "enum": [
                    "systemd",
                    "docker",
                    "native"
                  ]
                }
              },
              "required": [
                "name",
                "supervisor"
              ],
              "additionalProperties": false
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "applications",
          "backupJobs",
          "harnesses",
          "name",
          "os",
          "services",
          "tags"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "commit",
    "databases",
    "schemaVersion",
    "systems"
  ],
  "additionalProperties": false,
  "description": "The whole-fleet snapshot Fleet publishes to the Heimdall Hub (ADR-0010). Beyond this schema, the Hub refuses repeated names among Systems and among each System's Applications, Services, Backup Jobs, and Harnesses; repeated times in one schedule; a database name or role repeated on one System; and a database on a System the Inventory does not declare.",
  "title": "Heimdall Inventory v1"
}
